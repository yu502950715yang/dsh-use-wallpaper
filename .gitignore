# 依赖与构建产物
node_modules/
*.log

# 调研/临时代码（体积大，不入库）
research/
.superpowers/
.playwright-cli/
# Playwright 验证用产物：截图目录与临时浏览器数据（不入库）
output/
.pw-local/

# 隔离 worktree 目录（using-git-worktrees）
.worktrees/

# e2e 运行产物：截图与临时浏览器 profile
e2e/.out/

# 旧 monorepo 遗留（含被锁定的 node_modules），不再入库
packages/

# Rust wasm 构建中间产物：最终 wasm 由 build:client 复制进 dist/static 供分发
wasm/pkg/

# Wallpaper Engine 内置粒子纹理：**2026-09-11 起不再复制进 dist/static/** —— client 改为请求
# host 路由 /wallpapers/particle-texture（src/host/routes.ts），由 host 从用户本机的 WE 安装
# 目录 <weAssetsDir>/assets/materials 直读原始字节，故正常构建不会再产生这些文件。
# 规则保留作兜底：万一有历史产物或手工复制残留，也不会误入库 / 误进 npm 包（避免再分发第三方素材）。
dist/static/ptex-*.tex
